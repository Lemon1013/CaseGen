# CaseGen backend environment (no secrets)
# Copy to .env and pass it to Uvicorn with --env-file .env.
# Values below match backend/app/config.py defaults.

# Data root: raw uploads, wiki Markdown, and SQLite meta DB.
# Leave unset to use <repo>/data. Set an absolute path for a separate data copy.
# APP_DATA_DIR=C:/path/to/casegen-data

# LLM HTTP timeouts, in seconds.
LLM_DEFAULT_TIMEOUT_SEC=180
LLM_WIKI_TIMEOUT_SEC=300

# Retrieval and generation context.
RETRIEVE_TOP_K=6
RETRIEVE_WIKI_TOP_K=4
RETRIEVE_SOURCE_TOP_K=4
MAX_WIKI_CONTEXT_CHARS=12000
MAX_SOURCE_CONTEXT_CHARS=6000
SOURCE_CHUNK_CHARS=1200
SOURCE_CHUNK_OVERLAP=150

# Long-source Wiki analysis.
WIKI_ANALYZE_SINGLE_PASS_CHARS=48000
WIKI_ANALYZE_WINDOW_CHARS=12000
WIKI_ANALYZE_WINDOW_OVERLAP=1000
WIKI_ANALYZE_DIGEST_MAX=12000
WIKI_ANALYZE_PARTIAL_JSON_MAX=8000
WIKI_WRITE_ANALYSIS_CHARS=24000
WIKI_ANALYZE_WINDOW_RETRIES=2

# Minimum review score required to finalize a case set.
FINAL_SCORE_THRESHOLD=80
