# CaseGen backend environment (no secrets)
# Copy to .env and pass it to Uvicorn with --env-file .env.
# Values below match backend/app/config.py defaults.

# Data root: raw uploads, wiki Markdown, and SQLite meta DB.
# Leave unset to use <repo>/data. Set an absolute path for a separate data copy.
# APP_DATA_DIR=C:/path/to/casegen-data

# LLM HTTP timeouts, in seconds.
LLM_DEFAULT_TIMEOUT_SEC=180
LLM_WIKI_TIMEOUT_SEC=300
LLM_WIKI_STREAM=true
LLM_WIKI_MAX_TOKENS=16384
# auto disables DeepSeek V4 thinking for structured Wiki JSON; other models keep provider defaults.
LLM_WIKI_THINKING=auto

# Retrieval and generation context.
RETRIEVE_TOP_K=6
RETRIEVE_WIKI_TOP_K=4
RETRIEVE_SOURCE_TOP_K=4
MAX_WIKI_CONTEXT_CHARS=12000
MAX_SOURCE_CONTEXT_CHARS=6000
SOURCE_CHUNK_CHARS=1200
SOURCE_CHUNK_OVERLAP=150

# Long-source Wiki analysis.
WIKI_ANALYZE_SINGLE_PASS_CHARS=6000
WIKI_ANALYZE_WINDOW_CHARS=6000
WIKI_ANALYZE_WINDOW_OVERLAP=600
WIKI_ANALYZE_DIGEST_MAX=12000
WIKI_ANALYZE_PARTIAL_JSON_MAX=8000
WIKI_WRITE_ANALYSIS_CHARS=24000
WIKI_ANALYZE_WINDOW_RETRIES=2
WIKI_ANALYZE_REPAIR_RETRIES=1
WIKI_ANALYZE_REPAIR_CONTEXT_CHARS=16000
WIKI_ANALYZE_MAX_OPERATIONS=7

# Minimum review score required to finalize a case set.
FINAL_SCORE_THRESHOLD=80

# Authentication and credentialed browser CORS.
# Authentication is enabled by default; keep it enabled outside isolated tests.
CASEGEN_AUTH_ENABLED=true
CASEGEN_AUTH_COOKIE_NAME=casegen_session
CASEGEN_AUTH_CSRF_COOKIE_NAME=casegen_csrf
CASEGEN_AUTH_SESSION_DAYS=7
CASEGEN_AUTH_MAX_SESSIONS=8
# auto follows the request scheme for local HTTP/HTTPS. Set true in production
# when CaseGen is served over HTTPS so session cookies are never sent via HTTP.
CASEGEN_AUTH_COOKIE_SECURE=auto
# Comma-separated trusted browser origins. Do not use '*' with credentials.
CASEGEN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- DSH agent plane (line A) -------------------------------------------
# Base URL of the local DeepSeek Harness web-service API (no trailing slash).
# Keep it on the loopback interface: the browser never talks to this port.
DSH_BASE_URL=http://127.0.0.1:31800/api/v1
# Optional bearer token when the DSH service runs with authEnabled=true.
# Leave empty for the default loopback deployment (authEnabled=false).
DSH_API_TOKEN=
# Set false to switch the whole plane off: /api/agent/* then answers 410 and
# the frontend degrades softly.  The default is true because the Win10 target
# machine ships with a DSH runtime.
AGENT_ENABLED=true
# Maximum number of agent turns running at the same time (global semaphore).
AGENT_MAX_CONCURRENT=4
# Agent scratch root, outside the repository by default.  "~" expands to the
# user profile via Path.expanduser() (Linux /home/<user>, Windows
# C:\Users\<user>), so workspaces never land in the project.  Empty falls back
# to <APP_DATA_DIR>/agent-workspace.  One directory per conversation.  Set it
# before the deployment's first conversation: existing rows keep the old path.
AGENT_WORKSPACE_ROOT=~/.casegen/agent-workspace
# Read timeout for the first streamed token; model cold load can take minutes.
AGENT_FIRST_TOKEN_TIMEOUT_SEC=600
# Stall watchdog: a turn with no frame at all for this long is terminated.
AGENT_STALL_TIMEOUT_SEC=300
# Pipeline (line B) budget only; unused while PIPELINE_AGENT_STAGES is empty.
AGENT_STAGE_MAX_CALLS=4
# Comma-separated pipeline stages to run through the agent instead of the LLM.
# Empty keeps every stage on the legacy path (line B is out of scope for P1).
PIPELINE_AGENT_STAGES=
# Repo-relative skills root scanned by GET /api/agent/skills.
AGENT_SKILLS_DIR=.agents/skills
# DSH agent preset id for CaseGen sessions (empty = deployment default).
AGENT_PRESET=
