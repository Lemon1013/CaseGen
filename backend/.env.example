# CaseGen backend environment (no secrets)
# Copy to .env and adjust as needed. Values below match app/config.py defaults.

# Data root: raw uploads, wiki markdown, SQLite meta DB
# Default: <repo>/data
APP_DATA_DIR=

# LLM HTTP timeout in seconds
LLM_DEFAULT_TIMEOUT_SEC=120

# Wiki retrieval: number of top pages injected into generation context
RETRIEVE_TOP_K=6

# Max characters of wiki context passed to the generator
MAX_WIKI_CONTEXT_CHARS=12000

# Minimum review score required to finalize a case set
FINAL_SCORE_THRESHOLD=80
